# Copy to .env (never commit .env). Localnet/devnet only; no mainnet values anywhere (SPEC §1).
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
# Keys live in files outside the repo; admin, resolver, keeper and canonicalizer keys are all different.
KEEPER_KEYPAIR_PATH=
RESOLVER_KEYPAIR_PATH=
CANONICALIZER_KEYPAIR_PATH=
DATABASE_URL=postgres://prequel:prequel@127.0.0.1:5432/prequel
REDIS_URL=redis://127.0.0.1:6379
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Media storage (decision D-005). Leave empty until a provider is chosen.
PINATA_JWT=
# Observability
SENTRY_DSN=
